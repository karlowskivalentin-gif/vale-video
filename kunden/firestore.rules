rules_version = '2';

// =====================================================================
// vale-kunden — Firestore Security Rules
//
// Diese Regeln sind die ECHTE Sicherheitsgrenze (nicht roles.js, das ist
// nur UI). In der Firebase-Console unter Firestore Database → Rules
// einfügen und PUBLISH. NICHT aufs Hosting hochladen.
//
// Admin-Allowlist MUSS mit js/roles.js (ADMIN_EMAILS) übereinstimmen.
// Kunden sind dynamisch (Collection kundenmitglieder), NICHT mehr hartcodiert.
// Übergangs-Whitelist MUSS mit js/status.js (kundenFreigabeZiel /
// kundenAenderungZiel) übereinstimmen.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Identität ---------------------------------------------------
    function istEingeloggt() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function adminEmails() {
      return ['karlowskivalentin@gmail.com'];
    }
    function istAdmin() {
      return istEingeloggt() && email() in adminEmails();
    }
    // ÜBERGANGS-Fallback: die ursprünglichen Deussen-/Test-Adressen. Bis die
    // Migration ihre kundenmitglieder-Einträge angelegt hat, gelten sie weiter
    // als Kunde (Mandant „deussen"). NACH abgeschlossener Migration entfernen
    // (Härtung) — dann ist die Zugehörigkeit rein dynamisch.
    function altKundeEmails() {
      return ['n.berghaus@deussen-immobilien.de', 'c.deussen@deussen-immobilien.de',
              'valentinkolja@icloud.com', 'valentinkolja@gmail.com'];
    }
    // Kunde = wer einen kundenmitglieder/<email>-Eintrag hat. DYNAMISCH: der
    // Admin legt Kunden (+ ihre Login-E-Mails) zur Laufzeit über die
    // Kundenverwaltung an. Ersetzt die frühere hartcodierte kundeEmails()-Liste.
    function istKunde() {
      return istEingeloggt()
          && (exists(/databases/$(database)/documents/kundenmitglieder/$(email()))
              || email() in altKundeEmails());
    }
    // Zu welchem Kunden (kundeId) gehört die eingeloggte E-Mail? Übergang: fehlt
    // der kundenmitglieder-Eintrag noch (Alt-Adresse), gilt „deussen".
    function kundeVon() {
      return exists(/databases/$(database)/documents/kundenmitglieder/$(email()))
          ? get(/databases/$(database)/documents/kundenmitglieder/$(email())).data.kundeId
          : 'deussen';
    }
    function istErlaubt() {
      return istAdmin() || istKunde();
    }
    // Gehört ein kundenbezogenes Dokument dem eingeloggten Nutzer? Admin sieht
    // alles. Der default('deussen') ist das Sicherheitsnetz für Altbestände
    // während der Migration (Docs ohne kundeId gehören faktisch zu Deussen).
    // WICHTIG: Diese Bedingung steht direkt in der read-Regel — so scheitert
    // eine list-Query auf eine FREMDE kundeId (Firestore garantiert, dass jedes
    // zurückgegebene Doc die Regel erfüllt), nicht nur eine per-Doc-Prüfung.
    function gehoertMir(res) {
      return istAdmin()
          || (istKunde() && res.data.get('kundeId', 'deussen') == kundeVon());
    }

    // ---- Kollaborator (geteilte Map-Bearbeitung per Einmal-Code) ------
    // Wer ein Freischaltungs-Dokument kollaboratoren/<email> hat, darf GENAU
    // die dort hinterlegte Mindmap lesen/bearbeiten — sonst nichts.
    function istKollaborator() {
      return istEingeloggt()
          && exists(/databases/$(database)/documents/kollaboratoren/$(email()));
    }
    function kollaboratorMap() {
      return get(/databases/$(database)/documents/kollaboratoren/$(email())).data.mapId;
    }

    // ---- Map-Mitgliedschaft (geteilte + selbst angelegte Mindmaps) ----
    // Eine Map kennt ihre Nutzer über data.mitglieder. Wer Mitglied ist,
    // darf die Map und ihre Gedanken lesen/bearbeiten.
    function istMapMitglied(mapId) {
      return istEingeloggt()
          && exists(/databases/$(database)/documents/mindmaps/$(mapId))
          && email() in get(/databases/$(database)/documents/mindmaps/$(mapId)).data.get('mitglieder', []);
    }
    function darfAufMap(mapId) {
      return istAdmin()
          || (istKollaborator() && mapId == kollaboratorMap())
          || istMapMitglied(mapId);
    }

    // ---- Kunden-Übergangs-Whitelist (gespiegelt aus status.js) -------
    // Skript-Freigabe: freigeben (→ Drehbereit), ändern (→ Skript) ODER
    // verwerfen (→ Verworfen, „wird nicht gemacht"). Schnitt-Freigabe: freigeben
    // (→ Freigegeben) oder ändern (→ Schnitt).
    function erlaubterUebergang(alt, neu) {
      return (alt == '🔍 Freigabe Skript'  && (neu == '🎬 Drehbereit' || neu == '📝 Skript' || neu == '🚫 Verworfen'))
          || (alt == '🔎 Freigabe Schnitt' && (neu == '✅ Freigegeben' || neu == '✂️ Schnitt'));
    }
    // Kunde darf bei Video-Updates NUR diese Felder ändern und nur die
    // 4 erlaubten Status-Übergänge auslösen.
    function kundenVideoUpdateOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'freigabeSkript', 'freigabeSchnitt', 'aktualisiertAm'])
          && erlaubterUebergang(resource.data.status, request.resource.data.status);
    }

    // ---- objekte -----------------------------------------------------
    // Kundengetrennt: der Kunde sieht/meldet nur Objekte seiner eigenen kundeId.
    match /objekte/{objektId} {
      allow read: if gehoertMir(resource);
      allow create: if istErlaubt()
                    && request.resource.data.gemeldetVon.lower() == email()
                    && (istAdmin()
                        || (request.resource.data.status == 'Eingegangen'
                            && request.resource.data.kundeId == kundeVon()));
      allow update, delete: if istAdmin();
    }

    // ---- dateien --------------------------------------------------------
    // Große Dateien (Exposé-PDFs), blockweise abgelegt — siehe js/dateien.js.
    // Cloud Storage wäre der Lehrbuchweg, verlangt aber den Blaze-Plan; das
    // Projekt läuft auf Spark. Deshalb: ein Kopf-Dokument mit Metadaten und
    // die Rohdaten als Base64 in der Subcollection `teile`.
    //
    // Kundengetrennt wie `objekte`: lesen darf, wem die Datei gehört.
    // Unveränderlich nach dem Anlegen — eine gemeldete Unterlage soll nicht
    // nachträglich still ausgetauscht werden können; aufräumen darf der Admin.
    match /dateien/{dateiId} {
      allow read:   if gehoertMir(resource);
      allow create: if istErlaubt()
                    && request.resource.data.hochgeladenVon.lower() == email()
                    && (istAdmin() || request.resource.data.kundeId == kundeVon());
      allow update, delete: if istAdmin();

      // ---- teile (Subcollection) ---------------------------------------
      // Der Kopf entsteht ERST NACH den Blöcken (sonst zeigte er auf
      // Unvollständiges), deshalb kann die create-Regel hier nicht per get()
      // auf den Kopf prüfen — der existiert zu diesem Zeitpunkt noch nicht.
      // Grenze ist daher: eingeloggt + erlaubt, plus Blockgröße. Lesen ist
      // dagegen streng an den Kopf gebunden.
      function dateiKunde() {
        return get(/databases/$(database)/documents/dateien/$(dateiId))
                 .data.get('kundeId', 'deussen');
      }
      match /teile/{teilId} {
        allow read:   if istAdmin()
                      || (istKunde()
                          && exists(/databases/$(database)/documents/dateien/$(dateiId))
                          && dateiKunde() == kundeVon());
        // 900 KB Reserve unter der 1-MiB-Dokumentgrenze; js/dateien.js schneidet
        // bei 500 KB Rohdaten (~667 KB Base64).
        allow create: if istErlaubt() && request.resource.data.b64.size() < 900000;
        allow update, delete: if istAdmin();
      }
    }

    // ---- training / trainingKonfig --------------------------------------
    // Valentins eigene Trainingseinheiten (Springseil-Timer) und die zuletzt
    // benutzten Timer-Einstellungen. Streng privat: kein Kunde, kein
    // Kollaborator hat hier etwas zu suchen — nur der Admin.
    match /training/{einheitId} {
      allow read, write: if istAdmin();
    }
    match /trainingKonfig/{art} {
      allow read, write: if istAdmin();
    }

    // ---- roadmap -----------------------------------------------------
    // Valentins Geschäfts-Roadmap: EIN Dokument (roadmap/valentin) mit den
    // gesetzten Haken, dem Monatsumsatz und den Wochen-Aufgaben. Genau so
    // privat wie training: kein Kunde, kein Kollaborator.
    //
    // istAdmin() statt eines eigenen E-Mail-Vergleichs — sonst gaebe es zwei
    // Wahrheiten, und die Pruefung auf email_verified fiele hier weg.
    match /roadmap/{docId} {
      allow read, write: if istAdmin();
    }

    // ---- videos ------------------------------------------------------
    // Kundengetrennt (= die Pipeline). Der Kunde liest/aktualisiert nur Videos
    // seiner eigenen kundeId; die kundeId selbst darf er nie ändern.
    match /videos/{videoId} {
      allow read:          if gehoertMir(resource);
      allow create, delete: if istAdmin();
      allow update:        if istAdmin()
                           || (istKunde() && kundenVideoUpdateOk()
                               && request.resource.data.get('kundeId', 'deussen')
                                  == resource.data.get('kundeId', 'deussen'));

      // ---- kommentare (Subcollection) -------------------------------
      // Sichtbar/schreibbar nur für Admin und den Kunden, dem das Eltern-Video
      // gehört (get() auf das Video im selben Pfad).
      function videoKunde() {
        return get(/databases/$(database)/documents/videos/$(videoId))
                 .data.get('kundeId', 'deussen');
      }
      match /kommentare/{kommentarId} {
        allow read: if istAdmin() || (istKunde() && videoKunde() == kundeVon());
        allow create: if istErlaubt()
                      && request.resource.data.autor.lower() == email()
                      && (
                        (istAdmin() && request.resource.data.rolle == 'admin') ||
                        (istKunde() && request.resource.data.rolle == 'kunde'
                         && videoKunde() == kundeVon())
                      );
        // Nur der Admin darf den Bearbeitungs-Status einer Kunden-Nachricht
        // setzen (neu → gelesen → in Umsetzung → umgesetzt). Der Text/Autor/die
        // Rolle bleiben unveränderlich; der Kunde darf NIE updaten. Kein delete.
        allow update: if istAdmin()
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['bearbeitung', 'bearbeitetAm']);
        allow delete: if false;
      }
    }

    // ---- kommentare als collectionGroup (nur Admin, für die Pipeline) ---
    // Die Admin-Pipeline liest ALLE Kunden-Nachrichten in EINEM
    // collectionGroup-Query. Firestore verlangt dafür eine Regel mit
    // rekursivem Pfad-Wildcard — die verschachtelte videos/.../kommentare-Regel
    // oben autorisiert collectionGroup-Queries NICHT. Nur Lesen, nur Admin;
    // Schreiben/Anlegen läuft weiter ausschließlich über die verschachtelte Regel.
    match /{pfad=**}/kommentare/{kommentarId} {
      allow read: if istAdmin();
    }

    // ---- termine (manuelle Kalender-Einträge) ------------------------
    // Kundengetrennt: Kunde liest nur Termine seiner eigenen kundeId (read-only
    // Kalender); Admin legt an/ändert/löscht.
    match /termine/{terminId} {
      allow read:               if gehoertMir(resource);
      allow create, update, delete: if istAdmin();
    }

    // ---- plaene (private Video-/Konzept-Planung, Admin-only) ---------
    // Rein interner Planungsbereich („Incognito"). Der Kunde sieht das NIE:
    // weder lesen noch schreiben. Auch ein „veröffentlichter" Plan bleibt
    // hier — er wird nur vom Admin am Bildschirm als Referenz präsentiert.
    match /plaene/{planId} {
      allow read, write: if istAdmin();
    }

    // ---- shotvorlagen (wiederverwendbare Shot-Vorlagen, Admin-only) --
    // Globale Bibliothek einzelner Shot-Textzeilen, die der Admin in die
    // Shotlist eines Plans kopieren kann. Der Kunde sieht das NIE.
    match /shotvorlagen/{vorlageId} {
      allow read, write: if istAdmin();
    }

    // ---- gedanken (persönliche Mindmap, Admin-only) -----------------
    // Rein private Denk-/Ideen-Leinwand. Der Kunde sieht das NIE — weder
    // lesen noch schreiben. Gleiche Vertrauensgrenze wie plaene/shotvorlagen.
    match /gedanken/{gedankeId} {
      allow read:   if istAdmin() || darfAufMap(resource.data.get('mapId', 'default'));
      allow create: if darfAufMap(request.resource.data.get('mapId', 'default'));
      // Nicht-Admins dürfen die mapId eines Gedankens nicht ändern
      // (kein Verschieben in fremde/aus geteilten Maps).
      allow update: if istAdmin()
                    || (darfAufMap(resource.data.get('mapId', 'default'))
                        && request.resource.data.get('mapId', 'default') == resource.data.get('mapId', 'default'));
      allow delete: if istAdmin() || darfAufMap(resource.data.get('mapId', 'default'));
    }

    // ---- dateiblobs (Base64-Anhänge der Gedanken) -------------------
    // Admin: alles. Kollaborator: einzelne Blobs lesen (get) + neue anlegen.
    // Kunde: einzelne Blobs lesen (get) — nötig, damit Anhänge aus einem in
    // die Pipeline deployten Plan (planSnapshot) im Kundenportal angezeigt
    // werden. Kein list (Blob-IDs sind unvorhersehbar, nur über den Snapshot
    // des eigenen Videos erreichbar), kein Schreiben/Ändern/Löschen.
    match /dateiblobs/{blobId} {
      allow get:    if istAdmin() || istKollaborator() || istKunde();
      allow list:   if istAdmin();
      allow create: if istAdmin() || istKollaborator();
      allow update, delete: if istAdmin();
    }

    // ---- inspirationen (Inspirations-Dashboard, Admin-only) ----------
    // Cards mit Kategorie (profil|video|sonstiges), Referenz-Link (Video/
    // Account) und eigenen davon inspirierten Videos. Der Kunde sieht das NIE.
    match /inspirationen/{id} {
      allow read, write: if istAdmin();
    }

    // ---- brandskripte (Personal-Brand-Skriptwerkstatt, Admin-only) ---
    // Valentins eigene Video-Planung: Rohskript, Takes mit Kamera-Infos,
    // B-Roll-Bänder, Planungs-Checkliste, Shoot-Modus. Hat mit Kunden
    // nichts zu tun — gleiche Vertrauensgrenze wie gedanken/plaene.
    match /brandskripte/{id} {
      allow read, write: if istAdmin();
    }

    // ---- formate (Baupläne für eigene Videos, Admin-only) ------------
    // Wiederverwendbare Rezepte: Beats (= Take-Gerüst), Material-Bedarf,
    // Hook-Vorlagen, Referenzen auf /inspirationen. Gehört zu brandskripte.
    match /formate/{id} {
      allow read, write: if istAdmin();
    }

    // ---- kundenformate (Baupläne PRO KUNDE) --------------------------
    // Gleiche Struktur wie /formate, aber kundengetrennt: der Admin pflegt
    // sie, der Kunde sieht seine eigenen im Portal (nur lesen).
    //
    // BEWUSST eine eigene Collection statt eines kundeId-Feldes an /formate:
    // gehoertMir() faellt bei fehlendem Feld auf 'deussen' zurueck (Altbestand-
    // Netz), und Valentins Personal-Brand-Formate haben kein kundeId — sie
    // waeren damit fuer Deussen-Logins lesbar geworden.
    //
    // Auch kein gehoertMir() hier, sondern der direkte Vergleich: fehlt
    // kundeId an einem Dokument, schlaegt die Regel fehl (fail-closed) statt
    // es stillschweigend einem Kunden zuzuordnen. Die Bedingung steht in der
    // read-Regel, damit auch list-Queries auf eine fremde kundeId scheitern.
    match /kundenformate/{id} {
      allow read:  if istAdmin()
                   || (istKunde() && resource.data.kundeId == kundeVon());
      allow write: if istAdmin();
    }

    // ---- contentplan (Content-Kalender PRO KUNDE, Vale 04.10.2026) ----
    // Fest eingeplante und veröffentlichte Instagram-Posts (Termin, Caption,
    // Vorschaubild, Status, Link). Geschrieben nur vom Social-Brain-Cockpit
    // unter Valentins Admin-Login; der Kunde sieht nur seine eigenen —
    // fail-closed wie kundenformate (kein 'deussen'-Rückfall).
    match /contentplan/{id} {
      allow read:  if istAdmin()
                   || (istKunde() && resource.data.kundeId == kundeVon());
      allow write: if istAdmin();
    }

    // ---- moodboard (Kanal-Haftnotizen, Admin-only) -------------------
    // Persönliche Pinnwand mit Inspirations-YouTube-Kanälen (was gefällt,
    // was nachahmen). Der Kunde sieht das NIE.
    match /moodboard/{id} {
      allow read, write: if istAdmin();
    }

    // ---- fonts (Go-To-Schriften für Videos, Admin-only) --------------
    // Reine Notizsammlung: Name, exakter Familienname, Quelle, Verwendungs-
    // zweck. Keine Schriftdateien, nur Metadaten.
    match /fonts/{id} {
      allow read, write: if istAdmin();
    }

    // ---- fokusvideos (kuratierte Fokus-YouTube-Liste, Admin-only) ----
    // Private Anspiel-Liste auf der Fokus-Seite. Nur Metadaten (kein Blob).
    // Gleiche Vertrauensgrenze wie gedanken/plaene/shotvorlagen.
    match /fokusvideos/{id} {
      allow read, write: if istAdmin();
    }

    // ---- fokussessions (Verlauf der Fokus-Sessions, Admin-only) ------
    // Ein Doc = eine abgeschlossene Session (Name/Dauer/Start/Ende).
    match /fokussessions/{id} {
      allow read, write: if istAdmin();
    }

    // ---- mindmaps (benannte Gedanken-Leinwände) --------------------
    // Ein Doc = eine Mindmap { name, besitzer, mitglieder[] }. Admin
    // verwaltet alle. Kollaboratoren: sehen ihre Mitglieds-Maps + die per
    // Einladung geteilte; legen NUR eigene Maps an (sie selbst Besitzer und
    // einziges Mitglied); löschen nur eigene.
    match /mindmaps/{id} {
      allow get:   if istAdmin()
                   || (istEingeloggt() && email() in resource.data.get('mitglieder', []))
                   || (istKollaborator() && id == kollaboratorMap());
      allow list:  if istAdmin()
                   || (istEingeloggt() && email() in resource.data.get('mitglieder', []));
      allow create: if istAdmin()
                    || (istKollaborator()
                        && request.resource.data.get('besitzer', '') == email()
                        && request.resource.data.get('mitglieder', []) == [email()]);
      // Ändern: Admin frei. Außerdem darf sich ein Nutzer beim Einlösen seiner
      // Einladung selbst als Mitglied ergänzen (atomarer Batch, getAfter prüft
      // die frisch angelegte Freischaltung; bestehende Mitglieder bleiben).
      allow update: if istAdmin()
                    || (istEingeloggt()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mitglieder'])
                        && request.resource.data.get('mitglieder', []).hasAll(resource.data.get('mitglieder', []))
                        && email() in request.resource.data.get('mitglieder', [])
                        && getAfter(/databases/$(database)/documents/kollaboratoren/$(email())).data.mapId == id);
      allow delete: if istAdmin()
                    || (istEingeloggt() && resource.data.get('besitzer', '') == email());
    }

    // ---- benachrichtigungen (Glocke: anerkannt/kommentiert) ---------
    // Ein Doc = eine Nachricht an data.fuer. Lesen/als-gelesen-markieren
    // darf nur der Empfänger; anlegen jeder legitime Nutzer im eigenen Namen.
    match /benachrichtigungen/{id} {
      allow read:   if istAdmin() || (istEingeloggt() && resource.data.fuer == email());
      allow create: if (istErlaubt() || istKollaborator())
                    && request.resource.data.von == email()
                    && request.resource.data.fuer is string;
      allow update: if istAdmin()
                    || (istEingeloggt() && resource.data.fuer == email()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gelesen', 'erledigt']));
      allow delete: if istAdmin() || (istEingeloggt() && resource.data.fuer == email());
    }

    // ---- kollaboratoren (Freischaltung: E-Mail → eine Map) ---------
    // Ein Doc kollaboratoren/<email> = Zugriff auf data.mapId. Anlegen darf
    // sich ein Nutzer NUR SELBST, und nur wenn im selben Batch der zugehörige
    // Einladungscode (einladung/<mapId>) auf ihn eingelöst wird (getAfter).
    match /kollaboratoren/{kEmail} {
      allow get:    if istAdmin() || (istEingeloggt() && kEmail == email());
      allow list:   if istAdmin();
      allow create: if istEingeloggt()
                    && kEmail == email()
                    && request.resource.data.mapId is string
                    && getAfter(/databases/$(database)/documents/einladung/$(request.resource.data.mapId)).data.eingeloestVon == email();
      allow update, delete: if istAdmin();
    }

    // ---- einladung (Einmal-Codes) ----------------------------------
    // { code, mapId, eingeloestVon }. Der Code ist NICHT lesbar (nur Admin),
    // damit er nicht ausgespäht werden kann. Einlösen = eingeloestVon von null
    // auf die eigene E-Mail setzen UND den korrekten Code mitsenden (die Rule
    // prüft ihn gegen den gespeicherten). Danach ist der Code verbraucht.
    match /einladung/{id} {
      allow get, list: if istAdmin();
      allow create, delete: if istAdmin();
      allow update: if istAdmin()
                    || (istEingeloggt()
                        && resource.data.eingeloestVon == null
                        && request.resource.data.eingeloestVon == email()
                        && request.resource.data.code == resource.data.code
                        && request.resource.data.mapId == resource.data.mapId
                        && request.resource.data.keys().hasOnly(['code', 'mapId', 'eingeloestVon']));
    }

    // ---- kunden (Mandanten-Stammdaten) -----------------------------
    // Ein Doc = ein Kundenprofil { name, emails[], erstelltAm }. Nur der Admin
    // verwaltet Kunden. Ein Kunde darf sein EIGENES Profil lesen (z. B. Name),
    // aber nicht die Liste aller Kunden.
    match /kunden/{kundeId} {
      allow get:   if istAdmin() || (istKunde() && kundeId == kundeVon());
      allow list:  if istAdmin();
      allow write: if istAdmin();
    }

    // ---- kundenmitglieder (E-Mail → kundeId, autoritativer Lookup) --
    // Spiegelbild von kollaboratoren/<email>. Die Security Rules lesen diese
    // Collection intern (istKunde()/kundeVon()) — dafür braucht es KEINE
    // allow-Regel. Client-seitig liest nur auth.js das EIGENE Doc zur
    // Rollenauflösung. Geschrieben wird ausschließlich vom Admin (kundeSpeichern).
    match /kundenmitglieder/{kEmail} {
      allow get:   if istAdmin() || (istEingeloggt() && kEmail == email());
      allow list:  if istAdmin();
      allow write: if istAdmin();
    }

    // ---- bongnotizen (private Admin-Notizen zu gebongten Videos) ----
    // Rein interne Notizen zu „gebongten" Videos. Der Kunde sieht das NIE —
    // anders als videos/.../kommentare, die der Eigentümer-Kunde mitliest.
    // Gleiche Vertrauensgrenze wie plaene/gedanken/inspirationen.
    match /bongnotizen/{id} {
      allow read, write: if istAdmin();
    }

    // ---- skriptuploads (vom Kunden hochgeladene überarbeitete Skripte) ---
    // Kundengetrennt. Der Kunde lädt ein überarbeitetes Skript (Word/PDF, als
    // Base64) zu einem seiner Videos hoch; nur er (im eigenen Namen) und der
    // Admin sehen es. Bearbeiten/Löschen ausschließlich Admin.
    match /skriptuploads/{id} {
      allow read:   if gehoertMir(resource);
      allow create: if istErlaubt()
                    && request.resource.data.gemeldetVon.lower() == email()
                    && (istAdmin()
                        || request.resource.data.get('kundeId', 'deussen') == kundeVon());
      allow update, delete: if istAdmin();
    }

    // ---- feedback (schwebende Mini-Feedback-Box des Kunden) --------------
    // Kundengetrennt. Der Kunde hinterlässt beliebig viel Feedback (mit der
    // Seite/Route, auf der er war); nur er (im eigenen Namen) und der Admin
    // sehen es. Erledigt-Setzen/Löschen ausschließlich Admin.
    match /feedback/{id} {
      allow read:   if gehoertMir(resource);
      allow create: if istErlaubt()
                    && request.resource.data.gemeldetVon.lower() == email()
                    && (istAdmin()
                        || request.resource.data.get('kundeId', 'deussen') == kundeVon());
      allow update, delete: if istAdmin();
    }

    // =================================================================
    // ÖFFENTLICHE WEBSITE (vale-video.de) — die EINZIGEN Collections mit
    // Lesezugriff ohne Login. Sie enthalten ausschließlich Inhalte, die
    // Valentin bewusst veröffentlicht; nie Kundendaten.
    // =================================================================

    // ---- webvideos (Posts der öffentlichen Website) ------------------
    // Ein Doc = ein Video-Post (Link + Titel/Beschreibung/Kategorie).
    // Gelesen wird NUR, was veröffentlicht ist — Entwürfe bleiben privat.
    // WICHTIG: Wegen dieser Bedingung MUSS jede öffentliche Query ein
    // where("veroeffentlicht","==",true) enthalten, sonst weist Firestore
    // die gesamte Query ab (Rules filtern nicht, sie prüfen nur).
    match /webvideos/{id} {
      allow read:  if resource.data.veroeffentlicht == true || istAdmin();
      allow write: if istAdmin();
    }

    // ---- webthumbs (Vorschaubilder zu webvideos) ---------------------
    // Getrennt von webvideos, damit die Listen-Query der Website klein
    // bleibt und nicht jedes base64-Bild mitschleppt.
    match /webthumbs/{id} {
      allow read:  if true;
      allow write: if istAdmin();
    }

    // ---- webordner (Abschnitte des Portfolios) -----------------------
    // Ein Doc = ein Abschnitt auf portfolio.html (Überschrift + Reihenfolge).
    // Die Zugehörigkeit steht am jeweiligen Element (webvideos.ordnerId bzw.
    // webstatisch.ordnerId), nicht als Mitgliederliste hier — sonst müssten
    // beim Verschieben immer zwei Dokumente konsistent geändert werden.
    match /webordner/{id} {
      allow read:  if true;
      allow write: if istAdmin();
    }

    // ---- webstatisch (Einsortierung der 7 handgebauten Projektseiten) -
    // Enthält KEINE Inhalte, nur { ref, ordnerId, reihenfolge }. Die Seiten
    // selbst bleiben statisches HTML im Eltern-Repo.
    match /webstatisch/{id} {
      allow read:  if true;
      allow write: if istAdmin();
    }

    // ---- webseite (Startseiten-Baukasten) ----------------------------
    // Ein einziges Doc `startseite`: `kacheln` = veröffentlichter Stand,
    // `entwurf` = Arbeitsstand. Beides ist nur eine Anordnung von
    // Referenzen — nichts Schützenswertes.
    match /webseite/{id} {
      allow read:  if true;
      allow write: if istAdmin();
    }

    // ---- Social-Kennzahlen (Instagram, spaeter TikTok/YouTube) -------
    // Geschrieben werden diese drei Collections im Normalbetrieb vom
    // PHP-Connector (api/cron-social.php) ueber ein Google-Dienstkonto.
    // Das authentifiziert sich per IAM und laeuft an diesen Rules VORBEI —
    // hier steht deshalb nur, wer aus dem Portal heraus darf:
    //   lesen   = der eigene Mandant (gehoertMir prueft kundeId)
    //   schreiben = nur der Admin (manuelle Nacherfassung, Video-Verknuepfung)
    // Ein Kunde darf seine Zahlen also sehen, aber nicht schoenen.
    //
    // Zugangs-Tokens stehen bewusst NICHT in socialkonten: die Collection
    // ist fuer den Kunden lesbar, ein Instagram-Token waere damit ueber das
    // Client-SDK abgreifbar. Tokens liegen ausschliesslich serverseitig.
    match /socialkonten/{id} {
      allow read:  if gehoertMir(resource);
      allow write: if istAdmin();
    }

    match /socialsnapshots/{id} {
      allow read:  if gehoertMir(resource);
      allow write: if istAdmin();
    }

    match /socialposts/{id} {
      allow read:  if gehoertMir(resource);
      allow write: if istAdmin();
    }

    // ---- Alles andere: zu ------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
